{
  "mcpServers": {
    "n8n-mcp": {
      "command": "npx",
      "args": ["n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "TODO_REPLACE_WITH_YOUR_N8N_URL",
        "N8N_API_KEY": "TODO_REPLACE_WITH_YOUR_N8N_API_KEY"
      }
    }
  }
}
